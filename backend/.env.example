# AI provider: "mock" (no API key needed, works out of the box) or "groq"
AI_PROVIDER=mock

# Only required when AI_PROVIDER=groq. Get a free key at https://console.groq.com
GROQ_API_KEY=

# Model to use when AI_PROVIDER=groq
GROQ_MODEL=llama-3.1-8b-instant

# Comma-separated list of allowed frontend origins.
# Next.js falls back to 3001, 3002... if 3000 is already in use, so both
# are allowed by default to avoid a confusing CORS failure on first run.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# How many previous conversation turns to send to the AI layer
MAX_CONTEXT_TURNS=4

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
